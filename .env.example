# Environment Configuration for MediKiosk

# Environment mode: development / production
ENVIRONMENT=development

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./medikiosk.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Speech & OCR Provider Configuration
OCR_ENGINE=tesseract # or 'gemini', 'paddleocr'
SPEECH_PROVIDER=browser # or 'bhashini', 'ai4bharat'

# Storage
UPLOAD_DIR=./uploads

# Security / Session
SESSION_SECRET_KEY=change_this_secret_in_production
